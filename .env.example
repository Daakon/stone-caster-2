# === Model Provider (Gemini JSON-only) ===
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-1.5-pro
GEMINI_API_KEY=__REPLACE_ME__

# === Generation defaults (non-streaming) ===
MODEL_JSON_STRICT=1
MODEL_TIMEOUT_MS=30000
MODEL_MAX_TOKENS=800
MODEL_TEMPERATURE=0.7

# === Chat quotas ===
CHAT_DAILY_TOKENS_CAP=50000

# === App basics ===
NODE_ENV=development

# === Jev shadow comparison (optional, never authoritative) ===
# Set true only when TYPESAFE_API_KEY is available in the server environment.
JEV_SHADOW_MODE=false
JEV_SHADOW_TIMEOUT_MS=12000
# Canary flags are independent of shadow observation; each promoted family opts in separately and remains OFF by default.
JEV_CANARY_ACTION_CLASSIFICATION=false
JEV_CANARY_FEASIBILITY=false
JEV_CANARY_CONFIDENCE_THRESHOLD=0.80
# Compare mode runs GPT Director in parallel and logs disagreement. Set false with
# JEV_CANARY_SKIP_GPT=true only for the no-redundant-Director measurement mode.
JEV_CANARY_COMPARE=true
JEV_CANARY_SKIP_GPT=false
# Optional reporting-only per-turn GPT baseline used when the Director call is skipped.
# Set this from a measured local control run; it does not affect gameplay.
# JEV_CANARY_BASELINE_GPT_COST_USD=
# TYPESAFE_API_KEY=__OPTIONAL_TYPESAFE_KEY__
# Pricing is telemetry metadata only; it never affects gameplay decisions.
JEV_INPUT_USD_PER_1M_TOKENS=0.042
JEV_OUTPUT_USD_PER_1M_TOKENS=0
# JEV_MODEL=jev
# JEV_MODEL_VERSION=
# JEV_HIGH_CONFIDENCE_THRESHOLD=0.80
# JEV_RUNNER=sdk (set to cli only for the optional development fallback)
# JEV_CLI_COMMAND=jev.cmd
# GPT_DIRECTOR_INPUT_USD_PER_1M_TOKENS=0.15
# GPT_DIRECTOR_OUTPUT_USD_PER_1M_TOKENS=0.60
