{
  "name": "stone-caster-2",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-driven role-playing game platform with React/Vite frontend, Node/Express API, and Supabase backend",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "tools/author-cli"
  ],
  "scripts": {
    "dev": "node scripts/dev-local.js",
    "dev:clean": "npm run dev",
    "dev:parallel": "npm run dev:server & npm run dev:client",
    "dev:client": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev:server:local",
    "dev:server:local": "npm run dev:local --workspace=backend",
    "dev:server:prod": "npm run dev --workspace=backend",
    "kill:ports": "npx kill-port 3000 5173 5174 5175 || true",
    "start:client": "npm --workspace=frontend run preview",
    "start:server": "npm --workspace=backend run start",
    "start:server:local": "npm run start:local --workspace=backend",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=frontend",
    "build:server": "npm run build --workspace=backend",
    "test": "npm run test --workspaces",
    "test:client": "npm run test --workspace=frontend",
    "test:server": "npm run test --workspace=backend",
    "test:server:english": "npm run test:english --workspace=backend",
    "test:ci": "npm run test:ci --workspace=frontend && npm run test:ci --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:e2e:ci": "npm run test:e2e:ci --workspace=frontend",
    "seed:core": "tsx backend/scripts/seed-awf-core-contract.ts",
    "seed:v3": "tsx backend/scripts/seed-v3-fixtures.ts",
    "seed:master": "tsx backend/scripts/seed-v3-master.ts",
    "clear:v3": "tsx backend/scripts/clear-v3-fixtures.ts",
    "typecheck:strict": "cd backend && tsc --noEmit --strict",
    "preview:all": "tsx backend/scripts/preview-all-entry-points.ts",
    "qa:scan": "tsx backend/scripts/qa-scan-entry-points.ts",
    "ops:explain-v3": "psql $DATABASE_URL -f backend/scripts/explain-v3.sql",
    "ops:cache-stats": "curl -H 'X-Debug-Token: $DEBUG_ROUTES_TOKEN' http://localhost:3000/api/dev/debug/cache-stats",
    "canary:env-check": "tsx backend/scripts/canary-env-check.ts",
    "lint": "npm run lint --workspaces",
    "lint:client": "npm run lint --workspace=frontend",
    "lint:server": "npm run lint --workspace=backend",
    "type-check": "npm run type-check --workspaces",
    "type-check:client": "npm run type-check --workspace=frontend",
    "type-check:server": "npm run type-check --workspace=backend",
    "dev:setup": "node scripts/dev-setup.js",
    "setup": "npm run setup:env && npm run setup:config",
    "setup:env": "npm run setup:env --workspace=backend",
    "setup:config": "npm run setup:config --workspace=backend",
    "verify:config": "npm run verify:config --workspace=backend",
    "test:env-setup": "npm run test:env-setup --workspace=backend",
    "deploy": "npm run deploy --workspace=backend",
    "audit:awf": "tsx scripts/diagnostics/awf-prompt-audit.ts",
    "local:up": "node scripts/stonecaster-local.mjs stack:up",
    "local:down": "node scripts/stonecaster-local.mjs stack:down",
    "local:dev": "node scripts/stonecaster-local.mjs dev --mock",
    "local:dev:mock": "node scripts/stonecaster-local.mjs dev --mock",
    "local:dev:real": "node scripts/stonecaster-local.mjs dev --real",
    "local:reset": "node scripts/stonecaster-local.mjs reset",
    "content:validate": "tsx backend/src/scripts/content-validate.ts",
    "content:sync": "tsx backend/src/scripts/content-sync.ts",
    "content:deploy:check": "tsx backend/src/scripts/content-deploy-check.ts",
    "content:audit:hosted": "tsx backend/src/scripts/audit-hosted-content.ts",
    "backup:check": "node supabase/ops/check-backup.mjs",
    "wipe-prelaunch-data": "node supabase/ops/wipe-prelaunch-data.mjs",
    "test:f0a:local": "node supabase/ops/test-f0a-local.mjs",
    "test:f0b:entitlements:local": "node supabase/ops/test-f0b-entitlements.mjs",
    "local:health": "node scripts/stonecaster-local.mjs health",
    "local:smoke": "node scripts/stonecaster-local.mjs smoke --mock",
    "local:smoke:real": "node scripts/stonecaster-local.mjs smoke --real",
    "local:smoke:browser": "npm exec --workspace=frontend -- playwright test -c playwright.local.config.ts",
    "design:check": "node scripts/check-design-tokens.mjs",
    "ci:types": "node scripts/ci/check-typescript.mjs",
    "ci:lint:frontend": "node scripts/ci/run-eslint.mjs frontend",
    "ci:lint:backend": "node scripts/ci/run-eslint.mjs backend",
    "ci:lint": "npm run ci:lint:frontend && npm run ci:lint:backend",
    "ci:tests": "node scripts/ci/check-tests.mjs",
    "ci:all": "npm run ci:types && npm run ci:strict-types && npm run ci:lint && npm run ci:tests && npm run ci:strict-coverage && npm run design:check && npm run format:check && npm run ci:anti-gaming && npm run ci:architecture && npm run ci:knip",
    "format:check": "node scripts/ci/check-format.mjs",
    "format:fix": "node scripts/ci/check-format.mjs --write",
    "ci:architecture": "npm exec -- depcruise --config .dependency-cruiser.js --ignore-known .dependency-cruiser-known-violations.json backend/src frontend/src",
    "ci:knip": "node scripts/ci/check-knip.mjs",
    "ci:anti-gaming": "node scripts/ci/check-anti-gaming.mjs",
    "ci:strict-types": "node scripts/ci/check-strict-typescript.mjs",
    "ci:strict-coverage": "node scripts/ci/check-strict-coverage.mjs",
    "test:e2e:mocked": "npm exec --workspace=frontend -- playwright test -c playwright.mocked.config.ts",
    "ci:prove-gates": "node scripts/ci/prove-gates.mjs",
    "content:gc": "tsx backend/src/scripts/content-gc.ts",
    "test:f0b:gc:local": "node supabase/ops/test-f0b-gc.mjs",
    "test:f0b:deploy:local": "node supabase/ops/test-f0b-deploy.mjs",
    "test:f0b:readiness:local": "node --import tsx supabase/ops/test-f0b-readiness.mjs",
    "test:f0b:runtime-fence:local": "node --import tsx supabase/ops/test-f0b-runtime-fence.mjs"
  },
  "keywords": [
    "rpg",
    "ai",
    "storytelling",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "dependency-cruiser": "^18.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "kill-port": "^2.0.1",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "supabase": "2.117.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "dotenv": "^17.2.3"
  }
}
