{
  "__comment": "CHIMERA V3.5 COMPLETE LIBRARY - Backend-Logic Architecture + Schema Definitions",

  "0_SYSTEM_SCHEMAS": {
    "chimera_ruleset_schema": {
      "description": "The strict definition for any module in the system. updated for v1.8 architecture.",
      "fields": {
        "name": "Display Name (ID is now system-managed)",
        "ui_category": "Enum: [foundation, expansion, flavor]",
        "exclusion_group": "String (Optional) - Only one allowed per group per story",
        "dependencies": "Array[String] - Names of rulesets that MUST be present",
        "provides_tags": "Array[String] - Metadata tags for the Compiler",
        
        "state_contributions": {
          "description": "Defines Tier 1 keys. Must use target filters.",
          "structure": {
            "tier1_entity": {
              "target_kind": "Array[String] (e.g., ['npc', 'player'])",
              "definitions": {
                "__key_name": "Initial Value (e.g., fatigue: {current: 0, max: 100})",
                "narrative_cues": "Object (Required for AI readability) - Stores derived state (e.g., social_tone: 'Hostile')"
              }
            },
            "tier1_global": {
              "definitions": "Object - Global state keys"
            }
          }
        },

        "actions": {
          "description": "Defines executable logic (Mechanical, Interaction, or System Auto).",
          "structure": {
            "__action_key": {
              "kind": "Enum: [mechanical, interaction, system_auto]",
              "description": "String - Human readable tooltip",
              "trigger": "String (Optional) - Event listener for system_auto (e.g., 'on_stat_change(fatigue)')",
              "params": "Object - Required inputs (e.g., { amount: 'number' })",
              "logic": "String (Math expression) OR Array (Conditional Objects: [{ if: '...', then: '...' }])",
              "effects": "Object (Optional) - Side effects for interactions (e.g., { success: '...' })"
            }
          }
        },

        "ai_instructions": {
          "description": "Semantic instructions for the Compiler. No logic allowed here.",
          "fields": {
            "intent_mappings": "(MAS1) Dictionary of User Verbs -> Data Keys",
            "mechanical_triggers": "(MAS1) Rules for manual system triggers",
            "tone_instructions": "(MAS2) How narrative_cues influence voice/mood",
            "outcome_instructions": "(MAS2) How narrative_cues influence success/failure description",
            "framing_instructions": "(MAS2) Environmental description rules"
          }
        }
      }
    }
  },

  "1_STANDARD_LIBRARY_CATALOG": {
    
    "__comment_foundations": "=== STEP 1: FOUNDATIONS (THE HUBS) ===",

    "rs_relationship_core": {
      "name": "Deep NPC Behaviors",
      "ui_category": "foundation",
      "exclusion_group": "social_engine",
      "provides_tags": ["mechanics_social"],
      "description": "Tracks Personality DNA and ATR Model.",
      "state_contributions": {
        "tier1_entity": {
          "target_kind": ["npc", "player"],
          "definitions": {
            "social_dna": { "honesty": 50, "order": 50, "altruism": 50, "aggression": 50, "sociability": 50, "curiosity": 50 },
            "relationships": {},
            "narrative_cues": { "social_tone": "Neutral" }
          }
        }
      },
      "actions": {
        "modify_relationship": {
          "kind": "mechanical",
          "params": { "target_id": "string", "stat": "string", "amount": "number" },
          "logic": "target.relationships[actor_id][stat] += amount"
        },
        "update_social_cues": {
          "kind": "system_auto",
          "trigger": "on_stat_change(relationships)",
          "logic": [
            { "if": "relationships[target_id].affection < 30", "then": "narrative_cues.social_tone = 'Hostile'" },
            { "if": "relationships[target_id].trust > 70", "then": "narrative_cues.social_tone = 'Confiding'" }
          ]
        }
      },
      "ai_instructions": {
        "intent_mappings": "Deception/Truth -> 'social_dna.honesty'; Violence/Peace -> 'social_dna.aggression'.",
        "tone_instructions": "Adopt the 'social_tone' defined in narrative_cues."
      }
    },

    "rs_d100_core": {
      "name": "D100 Skill System",
      "ui_category": "foundation",
      "exclusion_group": "skill_engine",
      "provides_tags": ["mechanics_d100", "skills"],
      "state_contributions": {
        "tier1_entity": {
          "target_kind": ["npc", "player"],
          "definitions": {
            "skills": {},
            "xp_progress": 0,
            "narrative_cues": { "last_action_quality": "Average" }
          }
        }
      },
      "actions": {
        "roll_skill": {
          "kind": "interaction",
          "params": { "skill_id": "string" },
          "logic": [
            "let target_val = skills[skill_id] || 10",
            "let roll = 1d100",
            "if (roll <= target_val / 5) { narrative_cues.last_action_quality = 'Cinematic'; return 'critical_success' }",
            "if (roll <= target_val) { narrative_cues.last_action_quality = 'Competent'; return 'success' }",
            "narrative_cues.last_action_quality = 'Complicated'; return 'failure'"
          ],
          "effects": { "success": "xp_progress += 1" }
        }
      },
      "ai_instructions": {
        "mechanical_triggers": "If User action matches a key in 'entity.skills', trigger 'roll_skill(skill_id)'.",
        "outcome_instructions": "Describe the action using the style defined in 'narrative_cues.last_action_quality'."
      }
    },

    "rs_stamina_core": {
      "name": "Stamina & Exertion",
      "ui_category": "foundation",
      "exclusion_group": "base_energy_system",
      "state_contributions": {
        "tier1_entity": {
          "target_kind": ["npc", "player"],
          "definitions": { 
            "fatigue": { "current": 0, "max": 100 },
            "narrative_cues": { "physical_state": "Fresh" }
          }
        }
      },
      "actions": {
        "exertion": { "kind": "mechanical", "params": { "amount": "number" }, "logic": "fatigue.current += amount" },
        "update_fatigue_cues": {
          "kind": "system_auto",
          "trigger": "on_stat_change(fatigue)",
          "logic": [
            { "if": "fatigue.current < 50", "then": "narrative_cues.physical_state = 'Fresh'" },
            { "if": "fatigue.current >= 50", "then": "narrative_cues.physical_state = 'Winded'" }
          ]
        }
      },
      "ai_instructions": {
        "tone_instructions": "Describe movement based on 'narrative_cues.physical_state'."
      }
    },

    "__comment_expansions": "=== STEP 2: EXPANSIONS (THE SPOKES) ===",

    "rs_social_skills": {
      "name": "Social Skillset",
      "ui_category": "expansion",
      "dependencies": ["D100 Skill System", "Deep NPC Behaviors"],
      "state_contributions": {
        "tier1_entity": {
          "target_kind": ["npc", "player"],
          "definitions": { 
            "skills": { "persuade": 30, "intimidate": 30 },
            "narrative_cues": { "target_reaction": null }
          }
        }
      },
      "actions": {
        "intimidate": {
          "kind": "interaction",
          "logic": "roll_skill('intimidate')",
          "social_signature": { "aggression": 80 },
          "effects": {
            "success": "modify_relationship(target_id, 'respect', 10); narrative_cues.target_reaction = 'Cower'",
            "failure": "modify_relationship(target_id, 'affection', -10); narrative_cues.target_reaction = 'Scoff'"
          }
        }
      },
      "ai_instructions": {
        "intent_mappings": "Threats/Coercion -> 'intimidate'; Charm/Logic -> 'persuade'.",
        "outcome_instructions": "Describe the NPC's response based on 'narrative_cues.target_reaction'."
      }
    },

    "rs_survival_needs": {
      "name": "Survival Needs",
      "ui_category": "expansion",
      "dependencies": ["Stamina & Exertion"],
      "state_contributions": {
        "tier1_entity": {
          "target_kind": ["npc", "player"],
          "definitions": { 
            "needs": { "hunger": 0, "thirst": 0 },
            "narrative_cues": { "distraction_level": "None" }
          }
        }
      },
      "actions": {
        "check_needs": {
          "kind": "system_auto",
          "trigger": "on_scene_end",
          "logic": [
            { "if": "fatigue.current > 70", "then": "needs.hunger += 10; needs.thirst += 10" },
            { "if": "needs.hunger > 50", "then": "narrative_cues.distraction_level = 'Mild'" },
            { "if": "needs.hunger > 80", "then": "narrative_cues.distraction_level = 'Severe'" }
          ]
        }
      },
      "ai_instructions": {
        "tone_instructions": "Describe focus based on 'narrative_cues.distraction_level'. (Mild=Discomfort, Severe=Pain)."
      }
    }
  },

  "2_COMPILER_ARTIFACTS": {
    "compiled_story_example": {
      "description": "Example of a fully compiled story using the v1.8 Architecture.",
      "meta": {
        "active_rulesets": ["Deep NPC Behaviors", "D100 Skill System"],
        "tags": ["mechanics_d100", "mechanics_social"]
      },
      "master_schema": {
        "tier1_allowlist": ["skills", "xp_progress", "social_dna", "relationships", "narrative_cues"],
        "intent_mappings": {
          "threaten": "intimidate",
          "charm": "persuade"
        },
        "system_triggers": ["on_stat_change(relationships)", "on_turn_start"]
      }
    }
  }
}