  "rulesets": [
    {
      "id": "rs_core_driver_v3",
      "key": "core_driver",
      "name": "Core Interaction Driver",
      "ui_category": "foundation",
      "exclusion_group": "core_system",
      "provides_tags": ["mechanics_core", "turn_based"],
      "state_contributions": {
        "tier1_global": ["time", "weather"],
        "tier1_entity": ["skills", "relationships", "fatigue", "needs"]
      },
      "actions": {
        "CHECK": {
          "kind": "mechanical",
          "logic": "d20 + skill_score vs dc",
          "inputs": { "skill": "string", "dc": "number" }
        },
        "MOVE": {
          "kind": "narrative",
          "inputs": { "to": "location_id" }
        },
        "REL_DELTA": {
          "kind": "mechanical",
          "logic": "target.relationship[key] += delta",
          "inputs": { "who": "entity_id", "delta": "number" }
        }
      },
      "ai_instructions": {
        "mas1_hints": ["Respect scene phase locks.", "Mechanics only in acts array."],
        "mas2_style": ["2-6 sentences", "cinematic", "second-person", "No mechanics in text"]
      }
    },
    {
      "id": "rs_mystika_mechanics",
      "key": "mystika_mechanics",
      "name": "Mystika World Logic",
      "ui_category": "expansion",
      "dependencies": ["rs_core_driver_v3"],
      "provides_tags": ["magic_essence", "shifter_biology"],
      "state_contributions": {
        "tier1_global": {
          "time_bands": ["dawn_to_mid_day", "mid_day_to_evening", "evening_to_mid_night", "mid_night_to_dawn"]
        },
        "tier1_entity": {
          "essence_alignment": [],
          "shift_state": "human"
        }
      },
      "ai_instructions": {
        "mas2_style": ["grounded high fantasy", "sensory woods imagery", "kinship under pressure", "taboo: modern slang"]
      }
    },
