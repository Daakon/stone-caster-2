{
  "id": "mech_d100_core_v1",
  "pipeline_compatibility": ["v2025_01"],
  "name": "D100 Resolution Engine (Base 50)",
  "ui_category": "system_core",
  "exclusion_group": "resolution_mechanic",
  "description": "Defines the physics of the world using a D100 Roll-Under system where 50 is the human average.",

  "state_contributions": {
    "tier2_system": {
      "target_kind": ["global_rules"],
      "definitions": {
        "difficulty_tiers": {
          "value": {
            "TRIVIAL": 40,
            "EASY": 20,
            "NORMAL": 0,
            "HARD": -20,
            "IMPOSSIBLE": -40
          },
          "context_priority": "system_hidden",
          "description": "Modifiers applied to the base skill value."
        },
        "success_bands": {
            "value": {
                "critical_threshold": 5,
                "fumble_threshold": 96
            },
            "context_priority": "system_hidden",
            "description": "The static ranges for crit/fumble."
        }
      }
    }
  },

  "actions": {
    "resolve_skill_check": {
      "kind": "system_compute",
      "trigger": { "type": "request_match", "id": "execute_check" },
      "logic": [
        {
          "step_id": "calc_target",
          "function": "cat_03_resolution.math_add",
          "args": {
            "base": "@tier1_entity.active_skill_value",
            "modifier": "@tier2_system.difficulty_tiers.active_difficulty"
          }
        },
        {
          "step_id": "roll_dice",
          "function": "cat_03_resolution.rng_d100",
          "args": { "mode": "roll_under" }
        },
        {
          "step_id": "determine_outcome",
          "function": "cat_03_resolution.compare_outcome",
          "args": { 
             "roll": "@roll_dice.result",
             "target": "@calc_target.result",
             "crit_range": "@tier2_system.success_bands"
          }
        }
      ]
    }
  },

  "mas_directives": {
    "mas1_action_parser": {
      "instructions": [
        {
          "intent": "attempt_action",
          "logic": "Map user verb to the most relevant Skill ID. If context implies difficulty (e.g. 'rusty lock'), apply Modifier from Difficulty Tiers."
        }
      ]
    }
  }
}